{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovelobutto.example/schemas/waste-curation-register.schema.json",
  "title": "Reviewed waste aliases, collection streams, and delivery channels",
  "type": "object",
  "required": ["register_id", "version", "generated_at", "alias_groups", "eer_mappings", "collection_streams", "delivery_channels"],
  "properties": {
    "register_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "alias_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "preferred_label", "search_terms", "member_concept_ids", "review_status", "rationale"],
        "properties": {
          "group_id": { "type": "string", "pattern": "^waste-alias:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "search_terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "member_concept_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" }
          },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "eer_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mapping_id", "preferred_label", "eer_code", "concept_ids", "review_status", "rationale", "source_urls"],
        "properties": {
          "mapping_id": { "type": "string", "pattern": "^eer-map:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "eer_code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "concept_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" }
          },
          "condition": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "collection_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream_id", "preferred_label", "aliases"],
        "properties": {
          "stream_id": { "type": "string", "pattern": "^stream:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "delivery_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel_id", "preferred_label", "destination_type", "aliases"],
        "properties": {
          "channel_id": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "destination_type": {
            "enum": ["facility", "collection_point", "pickup", "special_case"]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
