{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovelobutto.example/schemas/waste-curation-register.schema.json",
  "title": "Reviewed waste aliases, collection streams, and delivery channels",
  "type": "object",
  "required": ["register_id", "version", "generated_at", "hazard_material_profiles", "curated_concepts", "alias_groups", "eer_mappings", "stream_mappings", "disambiguation_groups", "waste_classes", "family_mappings", "collection_streams", "delivery_channels"],
  "properties": {
    "register_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "hazard_material_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile_id", "preferred_label", "term_patterns", "hazardous_eer_codes", "reviewed_at", "review_status", "rationale", "source_urls"],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^hazard-profile:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "term_patterns": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "excluded_term_patterns": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "hazardous_eer_codes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{6}$" }
          },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "curated_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "preferred_label", "search_terms", "reviewed_at", "review_status", "rationale", "source_urls"],
        "properties": {
          "concept_id": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "search_terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } }
        },
        "additionalProperties": false
      }
    },
    "alias_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "preferred_label", "search_terms", "member_concept_ids", "review_status", "rationale"],
        "properties": {
          "group_id": { "type": "string", "pattern": "^waste-alias:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "search_terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "member_concept_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" }
          },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "eer_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mapping_id", "preferred_label", "eer_code", "concept_ids", "review_status", "rationale", "source_urls"],
        "properties": {
          "mapping_id": { "type": "string", "pattern": "^eer-map:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "eer_code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "concept_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" }
          },
          "condition": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "delivery_channels": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "stream_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mapping_id", "stream_id", "concept_ids", "condition", "reviewed_at", "review_status", "rationale", "source_urls"],
        "properties": {
          "mapping_id": { "type": "string", "pattern": "^stream-map:[a-z0-9-]+$" },
          "stream_id": { "type": "string", "pattern": "^stream:[a-z0-9-]+$" },
          "concept_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" }
          },
          "condition": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "disambiguation_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "trigger_concept_ids", "prompt", "options", "reviewed_at", "review_status", "rationale", "source_urls"],
        "properties": {
          "group_id": { "type": "string", "pattern": "^waste-question:[a-z0-9-]+$" },
          "trigger_concept_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" }
          },
          "prompt": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object",
              "required": ["concept_id", "label", "hint"],
              "properties": {
                "concept_id": { "type": "string", "pattern": "^waste:[a-z0-9-]+$" },
                "label": { "type": "string", "minLength": 1 },
                "hint": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "waste_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_id", "preferred_label", "stream_ids", "eer_codes", "delivery_channels"],
        "properties": {
          "class_id": { "type": "string", "pattern": "^waste-class:[a-z0-9-]+$" },
          "dimension": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "stream_ids": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^stream:[a-z0-9-]+$" }
          },
          "eer_codes": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{6}$" }
          },
          "delivery_channels": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" }
          },
          "hazard_compatible": { "type": "boolean" },
          "question": {
            "type": "object",
            "required": ["prompt", "options"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array", "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["outcome_id", "label", "hint", "stream_ids", "eer_codes", "delivery_channels"],
                  "properties": {
                    "outcome_id": { "type": "string", "pattern": "^waste-outcome:[a-z0-9-]+$" },
                    "label": { "type": "string", "minLength": 1 },
                    "hint": { "type": "string", "minLength": 1 },
                    "stream_ids": {
                      "type": "array", "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^stream:[a-z0-9-]+$" }
                    },
                    "eer_codes": {
                      "type": "array", "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^[0-9]{6}$" }
                    },
                    "delivery_channels": {
                      "type": "array", "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "family_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mapping_id", "source_categories", "destination_aliases", "class_id", "reviewed_at", "review_status", "rationale", "source_urls"],
        "properties": {
          "mapping_id": { "type": "string", "pattern": "^family-map:[a-z0-9-]+$" },
          "source_categories": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "destination_aliases": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "term_patterns": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "excluded_term_patterns": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "class_id": { "type": "string", "pattern": "^waste-class:[a-z0-9-]+$" },
          "priority": { "type": "integer", "minimum": 0 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_status": { "const": "approved" },
          "rationale": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "collection_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream_id", "preferred_label", "aliases"],
        "properties": {
          "stream_id": { "type": "string", "pattern": "^stream:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "delivery_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel_id", "preferred_label", "destination_type", "aliases"],
        "properties": {
          "channel_id": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" },
          "preferred_label": { "type": "string", "minLength": 1 },
          "destination_type": {
            "enum": ["facility", "collection_point", "pickup", "special_case"]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
