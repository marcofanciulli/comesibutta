{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovelobutto.example/schemas/disposal-answer.schema.json",
  "title": "Disposal answer returned to the app",
  "type": "object",
  "required": ["query", "context", "status", "result", "provenance"],
  "properties": {
    "query": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "matched_concept_id": { "type": ["string", "null"] },
        "matched_label": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["municipality_istat", "user_type", "as_of"],
      "properties": {
        "municipality_istat": { "type": "string", "pattern": "^[0-9]{6}$" },
        "zone_id": { "type": ["string", "null"] },
        "user_type": { "enum": ["domestic", "non_domestic"] },
        "as_of": { "type": "string", "format": "date" },
        "location": {
          "type": ["object", "null"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "required": ["latitude", "longitude"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["resolved", "needs_question", "not_found", "conflict", "outdated"]
    },
    "feedback": {
      "type": "object",
      "required": ["recorded", "reason"],
      "properties": {
        "recorded": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "question": {
      "type": ["object", "null"],
      "properties": {
        "text": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "hint": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": ["object", "null"],
      "properties": {
        "destination_type": {
          "enum": ["collection_stream", "facility", "collection_point", "pickup", "special_case", "portable_route"]
        },
        "stream_id": { "type": ["string", "null"], "pattern": "^stream:[a-z0-9-]+$" },
        "stream": { "type": ["string", "null"] },
        "source_destination": { "type": ["string", "null"] },
        "hazard_status": {
          "type": ["string", "null"],
          "enum": ["separate_handling_required", null]
        },
        "hazard_profile_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^hazard-profile:[a-z0-9-]+$" }
        },
        "suppressed_non_hazardous_eer_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{6}$" }
        },
        "channel_relation": {
          "type": ["string", "null"],
          "enum": ["single", "alternatives", null]
        },
        "delivery_channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel_id", "preferred_label", "destination_type", "matched_aliases"],
            "properties": {
              "channel_id": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" },
              "preferred_label": { "type": "string" },
              "destination_type": {
                "enum": ["facility", "collection_point", "pickup", "special_case"]
              },
              "matched_aliases": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "container": {
          "type": ["object", "null"],
          "properties": {
            "type": { "type": ["string", "null"] },
            "color": { "type": ["string", "null"] },
            "access_credential": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "presentation": {
          "type": ["object", "null"],
          "properties": {
            "mode": { "type": "string" },
            "instructions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "eer": {
          "type": ["object", "null"],
          "properties": {
            "code": { "type": "string", "pattern": "^[0-9]{6}$" },
            "official_label": { "type": "string" },
            "hazardous": { "type": "boolean" },
            "facility_operational_label": { "type": ["string", "null"] },
            "condition": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "eer_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "official_label", "hazardous", "facility_operational_label", "condition"],
            "properties": {
              "code": { "type": "string", "pattern": "^[0-9]{6}$" },
              "official_label": { "type": "string" },
              "hazardous": { "type": "boolean" },
              "facility_operational_label": { "type": ["string", "null"] },
              "condition": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "facility": {
          "oneOf": [{ "$ref": "#/$defs/facilityResult" }, { "type": "null" }]
        },
        "facility_alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/facilityResult" }
        },
        "channel_services": {
          "type": "array",
          "items": { "$ref": "#/$defs/channelService" }
        },
        "unresolved_channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/unresolvedChannel" }
        },
        "environmental_note": { "type": ["string", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "object" }
    },
    "provenance": {
      "type": "object",
      "required": ["verified_at", "sources"],
      "properties": {
        "verified_at": { "type": ["string", "null"], "format": "date-time" },
        "dataset_revision": { "type": ["integer", "null"], "minimum": 0 },
        "review_status": { "enum": ["automatic", "reviewed"] },
        "sources": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["url", "retrieved_at"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "retrieved_at": { "type": "string", "format": "date-time" },
              "label": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "channelService": {
      "type": "object",
      "required": [
        "id", "channel_id", "service_type", "zone_id", "name", "address",
        "location", "distance_km", "point_type", "accepted_waste",
        "compatibility", "schedule_raw", "access_summary", "access_credential",
        "booking_required", "booking_methods", "max_items", "quantity_limit",
        "instructions", "information_urls"
      ],
      "properties": {
        "id": { "type": "string" },
        "channel_id": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" },
        "service_type": { "enum": ["pickup", "collection_point"] },
        "zone_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "location": {
          "type": ["object", "null"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "method": { "type": "string" },
            "accuracy_m": { "type": ["number", "null"], "minimum": 0 }
          },
          "required": ["latitude", "longitude", "method", "accuracy_m"],
          "additionalProperties": false
        },
        "distance_km": { "type": ["number", "null"], "minimum": 0 },
        "point_type": { "type": ["string", "null"] },
        "accepted_waste": { "type": "array", "items": { "type": "string" } },
        "compatibility": {
          "enum": ["verified_description", "acceptance_not_published", "not_verified"]
        },
        "schedule_raw": { "type": ["string", "null"] },
        "access_summary": { "type": ["string", "null"] },
        "access_credential": { "type": ["string", "null"] },
        "information_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "booking_required": { "type": ["boolean", "null"] },
        "booking_methods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "value"],
            "properties": {
              "method": { "enum": ["web", "phone", "email", "app", "desk"] },
              "value": { "type": "string" },
              "hours_raw": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "max_items": { "type": ["integer", "null"], "minimum": 1 },
        "quantity_limit": { "type": ["string", "null"] },
        "instructions": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "unresolvedChannel": {
      "type": "object",
      "required": [
        "channel_id", "preferred_label", "status", "reason", "source_destination"
      ],
      "properties": {
        "channel_id": { "type": "string", "pattern": "^channel:[a-z0-9-]+$" },
        "preferred_label": { "type": "string" },
        "status": {
          "enum": [
            "source_only", "not_published", "acceptance_not_published",
            "compatibility_not_verified"
          ]
        },
        "reason": { "type": "string" },
        "source_destination": { "type": "string" }
      },
      "additionalProperties": false
    },
    "facilityResult": {
      "type": "object",
      "required": [
        "id", "name", "address", "location", "distance_km",
        "operational_status", "status_raw", "access_summary",
        "booking_required", "phone", "email", "information_urls",
        "opening_periods", "acceptance"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": ["string", "null"] },
        "location": {
          "type": ["object", "null"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "method": { "type": "string" },
            "accuracy_m": { "type": ["number", "null"], "minimum": 0 }
          },
          "required": ["latitude", "longitude", "method", "accuracy_m"],
          "additionalProperties": false
        },
        "distance_km": { "type": ["number", "null"], "minimum": 0 },
        "operational_status": {
          "enum": ["open", "closed", "temporarily_closed", "unknown"]
        },
        "status_raw": { "type": ["string", "null"] },
        "access_summary": { "type": ["string", "null"] },
        "booking_required": { "type": ["boolean", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"], "format": "email" },
        "information_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "opening_periods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "period_label", "start_month_day", "end_month_day",
              "weekly_intervals", "exceptions"
            ],
            "properties": {
              "period_label": { "type": ["string", "null"] },
              "start_month_day": { "type": ["string", "null"], "pattern": "^[0-9]{2}-[0-9]{2}$" },
              "end_month_day": { "type": ["string", "null"], "pattern": "^[0-9]{2}-[0-9]{2}$" },
              "weekly_intervals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["weekday", "opens", "closes"],
                  "properties": {
                    "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
                    "opens": { "type": "string" },
                    "closes": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "exceptions": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "acceptance": {
          "type": "object",
          "required": ["status", "basis", "eer_codes", "labels", "conditions"],
          "properties": {
            "status": {
              "enum": [
                "verified_eer", "verified_description",
                "acceptance_not_published", "not_listed"
              ]
            },
            "basis": { "type": ["string", "null"], "enum": ["eer", "description", null] },
            "eer_codes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9]{6}$" }
            },
            "labels": { "type": "array", "items": { "type": "string" } },
            "conditions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["resolved", "conflict", "outdated"] }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "sources": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
